; Hifi installer strings: Danish (Tauri ships none for it; it adds the UTF-8 BOM itself)
LangString addOrReinstall ${LANG_DANISH} "Tilføj/geninstaller komponenter"
LangString alreadyInstalled ${LANG_DANISH} "Allerede installeret"
LangString alreadyInstalledLong ${LANG_DANISH} "${PRODUCTNAME} ${VERSION} er allerede installeret. Vælg den handling, du vil udføre, og klik på Næste for at fortsætte."
LangString appRunning ${LANG_DANISH} "${PRODUCTNAME} kører! Luk programmet først, og prøv derefter igen."
LangString appRunningOkKill ${LANG_DANISH} "${PRODUCTNAME} kører!$\nKlik på OK for at tvangsafslutte det"
LangString chooseMaintenanceOption ${LANG_DANISH} "Vælg den vedligeholdelseshandling, der skal udføres."
LangString chooseHowToInstall ${LANG_DANISH} "Vælg, hvordan du vil installere ${PRODUCTNAME}."
LangString createDesktop ${LANG_DANISH} "Opret genvej på skrivebordet"
LangString dontUninstall ${LANG_DANISH} "Afinstaller ikke"
LangString dontUninstallDowngrade ${LANG_DANISH} "Afinstaller ikke (nedgradering uden afinstallation er deaktiveret i dette installationsprogram)"
LangString failedToKillApp ${LANG_DANISH} "${PRODUCTNAME} kunne ikke afsluttes. Luk programmet først, og prøv derefter igen"
LangString installingWebview2 ${LANG_DANISH} "Installerer WebView2..."
LangString newerVersionInstalled ${LANG_DANISH} "En nyere version af ${PRODUCTNAME} er allerede installeret! Det anbefales ikke at installere en ældre version. Hvis du virkelig vil installere denne ældre version, er det bedre først at afinstallere den nuværende version. Vælg den handling, du vil udføre, og klik på Næste for at fortsætte."
LangString older ${LANG_DANISH} "ældre"
LangString olderOrUnknownVersionInstalled ${LANG_DANISH} "En $R4 version af ${PRODUCTNAME} er installeret på din computer. Det anbefales at afinstallere den nuværende version før installationen. Vælg den handling, du vil udføre, og klik på Næste for at fortsætte."
LangString silentDowngrades ${LANG_DANISH} "Nedgraderinger er deaktiveret i dette installationsprogram, så den lydløse installation kan ikke fortsætte. Brug i stedet installationsprogrammet med grafisk brugerflade.$\n"
LangString unableToUninstall ${LANG_DANISH} "Afinstallationen kunne ikke udføres!"
LangString uninstallApp ${LANG_DANISH} "Afinstaller ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_DANISH} "Afinstaller før installation"
LangString unknown ${LANG_DANISH} "ukendt"
LangString webview2AbortError ${LANG_DANISH} "WebView2 kunne ikke installeres! Appen kan ikke køre uden. Prøv at genstarte installationsprogrammet."
LangString webview2DownloadError ${LANG_DANISH} "Fejl: Download af WebView2 mislykkedes - $0"
LangString webview2DownloadSuccess ${LANG_DANISH} "WebView2-bootstrapperen blev downloadet"
LangString webview2Downloading ${LANG_DANISH} "Downloader WebView2-bootstrapper..."
LangString webview2InstallError ${LANG_DANISH} "Fejl: Installation af WebView2 mislykkedes med afslutningskode $1"
LangString webview2InstallSuccess ${LANG_DANISH} "WebView2 blev installeret"
LangString deleteAppData ${LANG_DANISH} "Slet programdata"
