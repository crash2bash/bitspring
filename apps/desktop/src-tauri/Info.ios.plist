<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keep playing with the screen locked or another app in front. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The library folder shows up in Files (On My iPhone → BitSpring) and in Finder's file sharing. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- The UI's languages (src/lib/locales), so iOS lists them for the app and localizes system UI. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>fr</string>
		<string>es</string>
		<string>it</string>
		<string>pt-BR</string>
		<string>nl</string>
		<string>sv</string>
		<string>da</string>
		<string>nb</string>
		<string>fi</string>
		<string>pl</string>
		<string>cs</string>
		<string>hu</string>
		<string>ro</string>
		<string>el</string>
		<string>tr</string>
		<string>uk</string>
		<string>ru</string>
		<string>ar</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>ja</string>
		<string>ko</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>BitSpring</string>
	<!-- Any orientation: held sideways, a phone gets the one-screen layout (short screens count as
	     phones, see +page.svelte); the unfolded iPhone Duo is wide and tall enough for the layout
	     with the queue beside the player. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Only standard HTTPS: exempt from export compliance (no documents per upload). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
