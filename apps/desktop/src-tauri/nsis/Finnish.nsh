; BitSpring installer strings: Finnish (Tauri ships none for it; it adds the UTF-8 BOM itself)
LangString addOrReinstall ${LANG_FINNISH} "Lisää tai asenna komponentit uudelleen"
LangString alreadyInstalled ${LANG_FINNISH} "Asennettu jo"
LangString alreadyInstalledLong ${LANG_FINNISH} "${PRODUCTNAME} ${VERSION} on jo asennettu. Valitse suoritettava toiminto ja jatka valitsemalla Seuraava."
LangString appRunning ${LANG_FINNISH} "${PRODUCTNAME} on käynnissä! Sulje se ensin ja yritä sitten uudelleen."
LangString appRunningOkKill ${LANG_FINNISH} "${PRODUCTNAME} on käynnissä!$\nPakota se sulkeutumaan valitsemalla OK"
LangString chooseMaintenanceOption ${LANG_FINNISH} "Valitse suoritettava ylläpitotoiminto."
LangString chooseHowToInstall ${LANG_FINNISH} "Valitse, miten haluat asentaa sovelluksen ${PRODUCTNAME}."
LangString createDesktop ${LANG_FINNISH} "Luo pikakuvake työpöydälle"
LangString dontUninstall ${LANG_FINNISH} "Älä poista asennusta"
LangString dontUninstallDowngrade ${LANG_FINNISH} "Älä poista asennusta (vanhempaan versioon palaaminen ilman asennuksen poistoa ei ole käytössä tässä asennusohjelmassa)"
LangString failedToKillApp ${LANG_FINNISH} "Sovelluksen ${PRODUCTNAME} sulkeminen epäonnistui. Sulje se ensin ja yritä sitten uudelleen"
LangString installingWebview2 ${LANG_FINNISH} "Asennetaan WebView2:ta..."
LangString newerVersionInstalled ${LANG_FINNISH} "Sovelluksesta ${PRODUCTNAME} on jo asennettu uudempi versio! Vanhemman version asentamista ei suositella. Jos todella haluat asentaa tämän vanhemman version, nykyisen version asennus kannattaa poistaa ensin. Valitse suoritettava toiminto ja jatka valitsemalla Seuraava."
LangString older ${LANG_FINNISH} "vanhempi"
LangString olderOrUnknownVersionInstalled ${LANG_FINNISH} "Järjestelmään on asennettu sovelluksen ${PRODUCTNAME} $R4 versio. Nykyisen version asennus kannattaa poistaa ennen asentamista. Valitse suoritettava toiminto ja jatka valitsemalla Seuraava."
LangString silentDowngrades ${LANG_FINNISH} "Vanhempaan versioon palaaminen ei ole käytössä tässä asennusohjelmassa, joten hiljaista asennusta ei voi jatkaa. Käytä sen sijaan graafista asennusohjelmaa.$\n"
LangString unableToUninstall ${LANG_FINNISH} "Asennuksen poistaminen epäonnistui!"
LangString uninstallApp ${LANG_FINNISH} "Poista ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_FINNISH} "Poista asennus ennen asentamista"
LangString unknown ${LANG_FINNISH} "tuntematon"
LangString webview2AbortError ${LANG_FINNISH} "WebView2:n asentaminen epäonnistui! Sovellus ei toimi ilman sitä. Yritä käynnistää asennusohjelma uudelleen."
LangString webview2DownloadError ${LANG_FINNISH} "Virhe: WebView2:n lataaminen epäonnistui - $0"
LangString webview2DownloadSuccess ${LANG_FINNISH} "WebView2-käynnistysohjelman lataus onnistui"
LangString webview2Downloading ${LANG_FINNISH} "Ladataan WebView2-käynnistysohjelmaa..."
LangString webview2InstallError ${LANG_FINNISH} "Virhe: WebView2:n asentaminen epäonnistui, lopetuskoodi $1"
LangString webview2InstallSuccess ${LANG_FINNISH} "WebView2:n asennus onnistui"
LangString deleteAppData ${LANG_FINNISH} "Poista sovelluksen tiedot"
