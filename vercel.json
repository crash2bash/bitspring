{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix apps/website",
  "buildCommand": "npm run build --prefix apps/website",
  "outputDirectory": "apps/website/dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/website vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
