{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hifi",
  "version": "0.3.0",
  "identifier": "dev.local.hifi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hifi",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#16232a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "English",
          "German",
          "French",
          "Spanish",
          "Italian",
          "PortugueseBR",
          "Dutch",
          "Swedish",
          "Danish",
          "Norwegian",
          "Finnish",
          "Polish",
          "Czech",
          "Hungarian",
          "Romanian",
          "Greek",
          "Turkish",
          "Ukrainian",
          "Russian",
          "Arabic",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "customLanguageFiles": {
          "Danish": "nsis/Danish.nsh",
          "Finnish": "nsis/Finnish.nsh",
          "Polish": "nsis/Polish.nsh",
          "Czech": "nsis/Czech.nsh",
          "Hungarian": "nsis/Hungarian.nsh",
          "Romanian": "nsis/Romanian.nsh",
          "Greek": "nsis/Greek.nsh"
        }
      }
    },
    "android": {
      "minSdkVersion": 28
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0NzFERjJDMzEyRkQ2QjkKUldTNTFpOHhMTjl4dERMOUdyRUVYcWNwSGNTQkJ1VmMwZnlWK0c0bUNnYThlVDVJYUh2TVV3eUMK",
      "endpoints": [
        "https://github.com/crash2bash/hi-fi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
