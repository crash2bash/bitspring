{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://bitspring.app" }, { "url": "https://bitspring.app/*" }, { "url": "https://github.com/crash2bash/bitspring/issues/new*" }, { "url": "https://listenbrainz.org/settings/" }]
    }
  ]
}
