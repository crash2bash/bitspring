; BitSpring installer strings: Czech (Tauri ships none for it; it adds the UTF-8 BOM itself)
LangString addOrReinstall ${LANG_CZECH} "Přidat/přeinstalovat součásti"
LangString alreadyInstalled ${LANG_CZECH} "Již nainstalováno"
LangString alreadyInstalledLong ${LANG_CZECH} "Aplikace ${PRODUCTNAME} ${VERSION} je již nainstalována. Vyberte operaci, kterou chcete provést, a pokračujte kliknutím na Další."
LangString appRunning ${LANG_CZECH} "Aplikace ${PRODUCTNAME} je spuštěna! Nejprve ji zavřete a potom to zkuste znovu."
LangString appRunningOkKill ${LANG_CZECH} "Aplikace ${PRODUCTNAME} je spuštěna!$\nKliknutím na OK ji vynuceně ukončíte"
LangString chooseMaintenanceOption ${LANG_CZECH} "Vyberte operaci údržby, kterou chcete provést."
LangString chooseHowToInstall ${LANG_CZECH} "Vyberte, jak chcete aplikaci ${PRODUCTNAME} nainstalovat."
LangString createDesktop ${LANG_CZECH} "Vytvořit zástupce na ploše"
LangString dontUninstall ${LANG_CZECH} "Neodinstalovat"
LangString dontUninstallDowngrade ${LANG_CZECH} "Neodinstalovat (přechod na starší verzi bez odinstalace je v tomto instalačním programu zakázán)"
LangString failedToKillApp ${LANG_CZECH} "Aplikaci ${PRODUCTNAME} se nepodařilo ukončit. Nejprve ji zavřete a potom to zkuste znovu"
LangString installingWebview2 ${LANG_CZECH} "Instaluje se WebView2..."
LangString newerVersionInstalled ${LANG_CZECH} "Novější verze aplikace ${PRODUCTNAME} je již nainstalována! Instalace starší verze se nedoporučuje. Pokud opravdu chcete tuto starší verzi nainstalovat, je lepší nejprve odinstalovat aktuální verzi. Vyberte operaci, kterou chcete provést, a pokračujte kliknutím na Další."
LangString older ${LANG_CZECH} "starší"
LangString olderOrUnknownVersionInstalled ${LANG_CZECH} "V systému je nainstalována $R4 verze aplikace ${PRODUCTNAME}. Před instalací se doporučuje odinstalovat aktuální verzi. Vyberte operaci, kterou chcete provést, a pokračujte kliknutím na Další."
LangString silentDowngrades ${LANG_CZECH} "Přechod na starší verzi je v tomto instalačním programu zakázán, a tichou instalaci proto nelze provést. Použijte místo toho instalační program s grafickým rozhraním.$\n"
LangString unableToUninstall ${LANG_CZECH} "Odinstalace se nezdařila!"
LangString uninstallApp ${LANG_CZECH} "Odinstalovat ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_CZECH} "Před instalací odinstalovat"
LangString unknown ${LANG_CZECH} "neznámá"
LangString webview2AbortError ${LANG_CZECH} "Instalace WebView2 se nezdařila! Aplikace bez něj nemůže běžet. Zkuste instalační program spustit znovu."
LangString webview2DownloadError ${LANG_CZECH} "Chyba: Stažení WebView2 se nezdařilo – $0"
LangString webview2DownloadSuccess ${LANG_CZECH} "Zaváděcí program WebView2 byl úspěšně stažen"
LangString webview2Downloading ${LANG_CZECH} "Stahuje se zaváděcí program WebView2..."
LangString webview2InstallError ${LANG_CZECH} "Chyba: Instalace WebView2 se nezdařila s návratovým kódem $1"
LangString webview2InstallSuccess ${LANG_CZECH} "WebView2 byl úspěšně nainstalován"
LangString deleteAppData ${LANG_CZECH} "Odstranit data aplikace"
