<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the macOS bundle by Tauri. The UI speaks these languages (src/lib/locales):
	     declaring them lets macOS pick the app's language from the user's list, localize system
	     dialogs, and lay out window chrome right-to-left for Arabic. -->
	<!-- Asked once when the app first looks for network players (Sonos, WiiM…) and streams
	     to them. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>BitSpring looks for network players on your network (Sonos, WiiM, Bluesound, Chromecast and other UPnP/DLNA and Google Cast players) and streams your music to them, and lets a phone on your network control playback when you turn on the phone remote.</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>fr</string>
		<string>es</string>
		<string>it</string>
		<string>pt-BR</string>
		<string>nl</string>
		<string>sv</string>
		<string>da</string>
		<string>nb</string>
		<string>fi</string>
		<string>pl</string>
		<string>cs</string>
		<string>hu</string>
		<string>ro</string>
		<string>el</string>
		<string>tr</string>
		<string>uk</string>
		<string>ru</string>
		<string>ar</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>ja</string>
		<string>ko</string>
	</array>
	<!-- Only standard HTTPS (streaming, updates in the website build): exempt from export
	     compliance, so App Store Connect doesn't ask for documents on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
